# Copy to .env.local and edit values. Next.js loads .env.local automatically.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Site URL for metadata, Open Graph, etc. (see src/app/layout.tsx)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API (same pattern as realtra-central-auth-frontend):
# - Omit or leave unset → axios uses `/api` and Next.js rewrites `/api/*` to the backend (see next.config.ts).
# - Set to full URL (e.g. https://medplat.onrender.com/api) → axios calls that origin directly (needs CORS on the API).

# NEXT_PUBLIC_API_BASE_URL=https://medplat.onrender.com/api

# Optional: override rewrite target only (server-side; axios can still use default `/api`).
# API_PROXY_TARGET=http://127.0.0.1:8000/api
