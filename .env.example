# Copy to .env.local and edit values. Next.js loads .env.local automatically.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Site URL for metadata, Open Graph, etc. (see src/app/layout.tsx)
NEXT_PUBLIC_APP_URL=http://localhost:3021

# API base URL for axios (see src/lib/axios.ts)
NEXT_PUBLIC_API_BASE_URL=https://medplat.onrender.com/api
